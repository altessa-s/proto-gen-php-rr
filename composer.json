{
    "name": "altessa-s/proto-gen-php-rr",
    "description": "Generated PHP bindings (RoadRunner gRPC stubs) for the altessa-s/proto schemas.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "google/protobuf": "^3.25 || ^4.0",
        "google/common-protos": "^4.0",
        "spiral/roadrunner-grpc": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Io\\Altessa\\": "src/Io/Altessa/",
            "GPBMetadata\\": "src/GPBMetadata/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}